# LLM Provider Configuration: 'anthropic' or 'gemini'
LLM_PROVIDER=anthropic

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Recommended: claude-3-5-sonnet-20241022 or claude-3-7-sonnet-20250219
LLM_MODEL=claude-3-5-sonnet-20241022

# Google Gemini API Configuration (if using LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended for Gemini: gemini-1.5-pro or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-pro
